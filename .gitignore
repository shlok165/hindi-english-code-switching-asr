# Working files / provenance (regenerable, 10 MB+)
_work/

# Publisher PDFs - see README before enabling.
# ISCA/ACL papers are free to READ, but redistributing the PDFs in a public
# repo is a separate permission. Excluded by default; every paper is cited
# with a DOI in literature/papers.md and literature/comparison_table.csv.
literature/pdfs/

# Data (never commit - MUCS is ~9 GB, CC BY-SA 4.0, fetch from OpenSLR)
/data/
*.tar.gz
*.zip
*.wav
*.pt
*.bin

# Implementation phase
.venv/
__pycache__/
*.pyc
.pytest_cache/
checkpoints/
checkpoints.zip
research_paper/scripts/node_modules/
research_paper/scripts/package.json
research_paper/scripts/package-lock.json
*.safetensors
*.arpa
*.klm

# CPU rescoring outputs: the per-utterance and per-word CSVs are large and regenerable with src.score_files
results/cpu_eval/scoring/*/utterances.csv
results/cpu_eval/scoring/*/word_errors.csv
